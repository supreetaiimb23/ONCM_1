# ---------- App ----------
APP_ENV=production              # the app refuses to start with the default SECRET_KEY / MASTER_ADMIN_PASSWORD unless APP_ENV=development
APP_BASE_URL=http://localhost:8000
# Required: 32+ characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
TWO_PERSON_RULE=true            # true = Secondary Admin can only RECOMMEND approval; Master Admin gives final approval
REMINDER_DAYS=3,0               # days before deadline to send reminders

# ---------- Sign-in ----------
MFA_REQUIRED_FOR_ADMINS=true             # admins must set up two-step verification (authenticator app) before using admin pages

# ---------- First Master Admin (created on first start) ----------
MASTER_ADMIN_EMAIL=admin@example.org
MASTER_ADMIN_PASSWORD=ChangeMe!12345   # must be changed (except APP_ENV=development)
MASTER_ADMIN_NAME=ONCM Master Admin

# ---------- Database ----------
# Local dev (default): SQLite file, zero setup.
DATABASE_URL=sqlite:///./data/oncm.db
# Supabase: Project Settings > Database > Connection string (URI). Paste it here:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ---------- File storage ----------
# local = files saved in ./storage (a Docker volume). s3 = private AWS S3 bucket.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,csv,png,jpg,jpeg,txt

# To switch to S3: set STORAGE_BACKEND=s3 and fill these in
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=                # leave empty for AWS (set only for MinIO/other S3-compatible)

# ---------- Email (leave SMTP_HOST empty = emails are logged, not sent) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=workbench@your-domain.example
MAIL_REPLY_TO=oncm-support@your-domain.example
ONCM_SHARED_MAILBOX=oncm-support@your-domain.example

# ---------- Mail-in channel (optional): access requests emailed to the shared mailbox are picked up automatically ----------
# Works with any IMAP mailbox (Gmail, Zoho, SES->IMAP bridge, etc). Leave IMAP_HOST empty to disable.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
REVIEW_REMINDER_DAYS=3          # remind reviewers when a document has been in review this many days

# ---------- Admin alerts: a SEPARATE sender mailbox that emails your admins about joins, onboarding, documents, requests ----------
# Gmail: turn on 2-Step Verification, then Google Account > Security > App passwords, and paste the 16-character code below.
# (The normal Gmail password will NOT work.) Leave ALERT_SMTP_PASSWORD empty = alerts are recorded in the Admin alerts page but not sent.
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587             # 587 = STARTTLS, 465 = SSL
ALERT_SMTP_USER=alerts@example.org
ALERT_SMTP_PASSWORD=
ALERT_SMTP_USE_TLS=true
ALERT_MAIL_FROM=                # empty = ALERT_SMTP_USER (Gmail always sends as the signed-in account)
ALERT_FROM_NAME=ONCM Workbench Alerts
# Loaded ONCE on first start. After that add/remove recipients on the "Admin alerts" page (Master Admin).
ALERT_RECIPIENTS=admin1@example.org,admin2@example.org

# ---------- Virus scanning of uploads ----------
# clamav = every upload is scanned by the clamav service in docker-compose.yml; uploads are refused while it is down.
# off    = no scanning (local development without Docker only).
MALWARE_SCAN=clamav
CLAMAV_HOST=clamav                       # localhost without Docker (docker run -p 3310:3310 clamav/clamav:1.4.6-debian)
CLAMAV_PORT=3310

# ---------- Search ----------
# db     = search titles, document types and document codes (default, nothing else to run)
# engine = also search the text inside PDF / Word / Excel / text files with adaptive-search-engine.
#          Start it with: docker compose --profile search up -d --build   (needs ../adaptive-search-engine)
SEARCH_BACKEND=db
SEARCH_ENGINE_URL=http://search:8080     # the compose service; http://localhost:8080 without Docker
SEARCH_ENGINE_TOKEN=                     # 32+ random characters, shared with the engine (required for engine)
# Scanned PDFs and PNG/JPEG images are read with OCR (tesseract, included in the Docker image) for SEARCH_BACKEND=engine.
OCR_ENABLED=true
OCR_LANGUAGES=eng                        # e.g. eng+hin (the image needs tesseract-ocr-hin for Hindi)
OCR_MAX_PAGES=30                         # scanned pages read per document
